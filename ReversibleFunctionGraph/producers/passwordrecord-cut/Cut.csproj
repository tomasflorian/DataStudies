<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>passwordrecord-cut</AssemblyName>
    <RootNamespace>PasswordRecord</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- THE SAME FILE, not a copy. The whole point of the split is that one
         parser is reached two ways; two parsers would drift. -->
    <Compile Include="../passwordrecord/PasswordRecords.cs" />
  </ItemGroup>
</Project>
