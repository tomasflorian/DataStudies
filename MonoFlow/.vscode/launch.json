{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug monoflow2",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/monoflow2.ts",
        "thecatwasoldandhappy",
        "--cycles=2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
      {
        "name": "Debug monoflow5",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npx",
        "runtimeArgs": [
          "tsx",
          "src/monoflow5.ts",
          "corpus/alice.txt",
          "--order=5",
          "--ent-order=3",
          "--margin=0.2",
          "--min-len=2",
          "--show=300"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
  ]
}
